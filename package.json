{
  "name": "social-frontend-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "E2E tests for Social Frontend",
  "scripts": {
    "test": "playwright test --grep-invert @mutation",
    "test:all": "cross-env RUN_MUTATION_TESTS=true playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:critical": "cross-env RUN_MUTATION_TESTS=true playwright test --project=desktop-chromium --grep @critical",
    "test:auth-ui": "playwright test --project=unauthenticated-chromium",
    "test:readonly": "playwright test --grep-invert @mutation",
    "test:mutation": "cross-env RUN_MUTATION_TESTS=true playwright test --grep @mutation",
    "test:integration": "playwright test --grep @diagnostic --grep-invert @mutation",
    "test:e2e": "playwright test --project=desktop-chromium --grep-invert @diagnostic",
    "test:multiuser": "playwright test --project=multi-user-chromium --grep @multiuser",
    "test:desktop": "playwright test --project=desktop-chromium --grep-invert @mutation",
    "test:mobile": "playwright test --project=mobile-chromium --project=mobile-webkit --grep @mobile",
    "test:mobile:chromium": "playwright test --project=mobile-chromium --grep @mobile",
    "test:mobile:webkit": "playwright test --project=mobile-webkit --grep @mobile",
    "test:headed": "playwright test --headed --project=desktop-chromium --grep-invert @mutation",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "cross-env": "^10.0.0",
    "dotenv": "^17.0.0",
    "typescript": "^5.9.0"
  }
}
