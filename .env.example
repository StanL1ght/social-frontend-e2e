BASE_URL=https://dev-social-frontend.sddt.efko.ru
E2E_EMAIL=your-test-user@example.com
E2E_PASSWORD=replace-me

# Второй тестовый пользователь для проверок подписок, ролей и прав.
E2E_MEMBER_EMAIL=second-test-user@example.com
E2E_MEMBER_PASSWORD=replace-me

# URL группы, которой управляет первый пользователь; второй пользователь в ней состоит.
E2E_MANAGED_GROUP_URL=https://dev-social-frontend.sddt.efko.ru/group/replace-with-group-id
E2E_MEMBER_CAN_PUBLISH=false

# Поисковая строка, по которой находится второй пользователь в подсказках @.
E2E_MENTION_QUERY=Тест

# Разрешает тестам создавать и удалять тестовые посты, комментарии, реакции и группы.
RUN_MUTATION_TESTS=false

# Регулярное выражение для сохранения интересующих API-запросов в network.json.
NETWORK_URL_FILTER=multisearch|multi-search|private-web|search|catalog|person|post|group
